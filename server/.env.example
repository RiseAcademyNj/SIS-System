# Which Google Sheet to read. Normally set via config/sheet-link.txt (copy
# config/sheet-link.example.txt) instead — this env var is only a fallback
# for hosts where dropping a file into the repo isn't convenient.
# SHEET_LINK=https://docs.google.com/spreadsheets/d/.../edit

# How often to re-poll the sheet, in milliseconds
POLL_INTERVAL_MS=5000

# Sessions
SESSION_SECRET=replace-with-a-long-random-string
PORT=3001
NODE_ENV=development

# CORS: URL the client is served from
CLIENT_ORIGIN=http://localhost:5173
